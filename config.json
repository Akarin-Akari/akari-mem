{
    "embedding": {
        "mode": "onnx",
        "model": "BAAI/bge-m3",
        "model_path": "F:/models/bge-m3-onnx-fp16",
        "device": "cuda",
        "max_length": 512,
        "normalize": true,
        "pooling": "cls",
        "prefer_trt": false,
        "trt_workspace_mb": 1024,
        "gpu_mem_limit_gb": 4.0
    },
    "rerank": {
        "mode": "onnx",
        "model": "jinaai/jina-reranker-v2-base-multilingual",
        "cache_dir": "F:/models/fastembed",
        "device": "cpu",
        "max_length": 256,
        "gpu_mem_limit_gb": 1.0,
        "prefer_int8": true,
        "cpu_threads": 8
    },
    "idle_unload": {
        "enabled": true,
        "timeout_seconds": 600,
        "targets": ["reranker", "embedding"]
    },
    "daemon": {
        "host": "127.0.0.1",
        "port": 37800,
        "spawn_timeout_seconds": 60,
        "request_timeout_seconds": 300,
        "idle_shutdown_seconds": 1800
    },
    "log_level": "INFO"
}
